<Window x:Class="KanKan.Memos.TextSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="텍스트 설정" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        FontFamily="Malgun Gothic"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- 바깥 여백은 그림자 자리 -->
    <Border Margin="10" Background="White" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1" Padding="16,12,16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="텍스트 설정" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Content="기본값" Padding="10,3" Cursor="Hand"
                        Background="#F0F3F7" BorderBrush="#D5DCE5" Click="Reset_Click"/>
            </Grid>

            <DockPanel Margin="0,0,0,2">
                <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right" Foreground="#555"/>
                <TextBlock Text="글자 크기" Foreground="#333"/>
            </DockPanel>
            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,12" ValueChanged="Slider_ValueChanged"/>

            <DockPanel Margin="0,0,0,2">
                <TextBlock x:Name="LineSpacingValue" DockPanel.Dock="Right" Foreground="#555"/>
                <TextBlock Text="행간" Foreground="#333"/>
            </DockPanel>
            <Slider x:Name="LineSpacingSlider" Minimum="1" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                    ValueChanged="Slider_ValueChanged"/>

            <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#888" TextWrapping="Wrap"
                       Text="이 메모 영역에만 적용돼요. 자간은 지원하지 않아요."/>
        </StackPanel>
    </Border>
</Window>
